    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.4.2",
    "@sentry/node": "^10.32.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tanstack/react-query": "^5.12.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.18.1",
