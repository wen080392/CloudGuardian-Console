# ==============================================
# CloudGuardian Console — Environment Variables
# ==============================================

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Firebase (Frontend SDK) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Firebase (Admin SDK — Backend) ----
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B: Inline JSON string
# FIREBASE_SERVICE_ACCOUNT='{...}'

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ---- Google Gemini AI ----
GEMINI_API_KEY=

# ---- ElevenLabs TTS (Optional) ----
ELEVENLABS_API_KEY=

# ---- AWS S3 & KMS (Optional — falls back to local storage) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=
S3_BUCKET=cloudguardian-reports

# ---- Scan Engine ----
# auto   = usa Checkov se estiver no PATH, senão o engine nativo (padrão)
# checkov = força Checkov no host (falha se ausente)
# docker  = roda Checkov em container isolado (recomendado em produção)
SCAN_RUNNER=auto
CHECKOV_IMAGE=bridgecrew/checkov:latest

# ---- GitHub App (Optional) ----
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
# Token PAT para auto-remediação (abertura de PRs de correção)
GITHUB_TOKEN=

# ---- Email / SMTP (Optional) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=notifications@cloudguardian.io
