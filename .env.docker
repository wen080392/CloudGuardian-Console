# ==============================================================
# .env PRONTO para rodar LOCAL com docker compose.
#
#   Windows (PowerShell):  Copy-Item .env.docker .env
#   Mac/Linux:             cp .env.docker .env
#   depois:                docker compose up -d --build
#
# NÃO contém segredos reais — são valores locais de desenvolvimento.
# NÃO use este arquivo em produção (veja docs/GO_LIVE.md).
# ==============================================================

# ---- Banco de dados (OBRIGATÓRIO) ----
# O host é "postgres" (nome do serviço no docker-compose), NÃO localhost:
# o app roda dentro da rede do compose.
# DB_PASSWORD é lido pelo compose ao criar o Postgres; mantenha os dois valores
# iguais (se mudar a senha, mude nos dois lugares).
DB_PASSWORD=cloudguardian_dev_123
DATABASE_URL="postgresql://cloudguardian:cloudguardian_dev_123@postgres:5432/cloudguardian"

# ---- Fila distribuída (o compose já sobe o Redis) ----
REDIS_URL=redis://redis:6379
QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=3

# ---- Motor de scan ----
# "auto" usa o engine nativo se o Checkov não estiver disponível.
# Não use "docker" aqui: exigiria acesso ao daemon Docker de dentro do contêiner.
SCAN_RUNNER=auto

# ---- Policy engine (OPA) ----
# Sem o binário OPA, a validação de sintaxe Rego é pulada graciosamente.
OPA_PATH=opa

# ==============================================================
# OPCIONAIS — deixe vazio para rodar local.
# Cada bloco vazio apenas DESLIGA aquela funcionalidade; o app sobe normal.
# ==============================================================

# ---- AWS KMS/S3 ----
# Vazio = não é possível SALVAR credenciais de nuvem (fail-closed proposital,
# pois o compose roda com NODE_ENV=production). O resto do app funciona.
# Para habilitar, preencha os 4 campos abaixo.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=
S3_BUCKET=

# ---- Firebase (frontend) ----
# Pode deixar vazio: há fallback em firebase-applet-config.json (commitado).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Google Gemini (assistente de IA) ----
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# ---- GitHub App / auto-remediação ----
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_TOKEN=

# ---- Email / SMTP ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=notifications@cloudguardian.io

# ---- Outros ----
ELEVENLABS_API_KEY=
SENTRY_DSN=
