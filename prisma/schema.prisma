// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  plan      String    @default("starter")
  users     User[]
  projects         Project[]
  policies         Policy[]
  complianceReports ComplianceReport[]
  notificationSetting NotificationSetting?
  credentials      CloudCredential[]
  auditLogs        AuditLog[]
  createdAt        DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String?  @unique
  email       String   @unique
  name        String?
  role        String   @default("viewer")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]

  @@index([tenantId])
}

model Project {
  id           String   @id @default(uuid())
  name         String
  cloud        String
  region       String
  status       String   @default("active")
  score        Int      @default(100)
  repoUrl      String?
  githubRepoId String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  scans        Scan[]

  @@index([tenantId])
}

model Scan {
  id          String   @id @default(uuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  // tenantId direto permite scans ad-hoc (sem projeto) isolados por tenant
  tenantId    String?
  vulnsCount  Int      @default(0)
  code        String?
  fullCode    String?
  status      String   @default("pending")
  engine      String?  // checkov | checkov-docker | native
  result      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([tenantId, createdAt])
}

model Asset {
  id         String   @id @default(uuid())
  name       String
  type       String
  category   String
  provider   String
  region     String
  status     String   @default("running")
  riskScore  Int      @default(0)
  cost       Float    @default(0)
  tags       Json?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model Vulnerability {
  id          String   @id @default(uuid())
  scanId      String?  
  resourceId  String   
  ruleId      String   
  title       String
  description String?
  severity    String   
  status      String   
  filePath    String?  
  line        Int?     
  details     Json?
  tenantId    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, severity, status])
  @@index([tenantId, createdAt])
}

model CostAnalysis {
  id          String   @id @default(uuid())
  tenantId    String
  source      String   @default("estimate") // aws-cost-explorer | estimate
  period      String
  startDate   DateTime
  endDate     DateTime
  totalCost   Float    @default(0)
  projectedCost Float  @default(0)
  savings     Float    @default(0)
  efficiency  Float    @default(0)
  resources   Json
  services    Json
  tags        Json
  recommendations Json
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model BudgetAlert {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  threshold   Float
  period      String
  comparison  String
  channels    String[]
  recipients  String[]
  enabled     Boolean  @default(true)
  triggered   Boolean  @default(false)
  triggeredAt DateTime?
  currentSpend Float   @default(0)
  lastChecked DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model Policy {
  id             String   @id @default(cuid())
  name           String
  description    String?
  type           String   // security, compliance, cost, custom
  framework      String?  // CIS, SOC2, HIPAA, custom
  severity       String   // critical, high, medium, low, info
  regoCode       String   // Código Rego da política
  enabled        Boolean  @default(true)
  autoRemediate  Boolean  @default(false)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  
  passedCount    Int      @default(0)
  failedCount    Int      @default(0)
  lastEvaluated  DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluations    PolicyEvaluation[]

  @@index([tenantId])
}

model PolicyEvaluation {
  id          String   @id @default(cuid())
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id])
  resourceId  String?
  result      String   // pass, fail, error
  details     Json?
  evaluatedAt DateTime @default(now())
  tenantId    String

  @@index([tenantId])
  @@index([policyId])
}

model ComplianceReport {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  title       String
  framework   String   // CIS, SOC2, HIPAA, GDPR
  period      String   // "Mensal", "Trimestral", etc.
  startDate   DateTime
  endDate     DateTime
  
  summary     Json     // Resumo executivo (objeto com métricas)
  controls    Json     // Lista de controles
  metrics     Json     // Métricas detalhadas
  findings    Json     // Achados e recomendações
  
  status      String   // draft, completed, published, archived
  pdfUrl      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model NotificationSetting {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  slackWebhook   String?  
  teamsWebhook   String?  
  emailRecipients String[] 
  enabledEvents  String[]  

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CloudCredential {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  provider    String   // "aws", "gcp", "azure", "github"
  roleArn     String?  
  accessKey   String?  // Criptografado via KMS
  secretKey   String?  // Criptografado via KMS
  region      String?  

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, provider])
}

// Funil PLG: lead que rodou a "auditoria de 5 minutos" sem conta
model Lead {
  id        String        @id @default(uuid())
  email     String
  company   String?
  source    String        @default("instant-audit")
  createdAt DateTime      @default(now())
  audits    InstantAudit[]

  @@index([email])
}

model InstantAudit {
  id            String   @id @default(uuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  score         Int
  engine        String   // native | checkov
  totalFindings Int      @default(0)
  summary       Json     // contagem por severidade
  findings      Json     // lista resumida
  downloadToken String   @unique
  convertedTenantId String? // preenchido se o lead virar cliente
  createdAt     DateTime @default(now())

  @@index([leadId])
}

model Drift {
  id           String   @id @default(uuid())
  tenantId     String
  projectId    String?
  resource     String   // endereço do recurso (ex.: aws_s3_bucket.assets)
  driftType    String   // update | delete | create
  provider     String?  // aws | gcp | azure
  severity     String   @default("medium")
  status       String   @default("detected") // detected | resolved | ignored
  expected     Json?    // estado desejado (do IaC)
  actual       Json?    // estado real (da cloud)
  source       String   @default("terraform-refresh") // terraform-refresh | derived
  detectedAt   DateTime @default(now())
  resolvedAt   DateTime?

  @@index([tenantId, status])
  @@index([projectId])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String?
  action      String
  resourceId  String?
  resourceType String?
  details     Json?
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
